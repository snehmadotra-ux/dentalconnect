# DentalConnect Environment Configuration

# Application
APP_NAME=DentalConnect
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-super-secure-change-in-prod-123456789
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_USER=dental_user
POSTGRES_PASSWORD=dental_secure_password
POSTGRES_DB=dentalconnect_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dental_user:dental_secure_password@localhost:5432/dentalconnect_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible Object Storage for X-Rays)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_key
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=dental-xrays

# ZITADEL Identity Provider (AuthN & AuthZ)
ZITADEL_ISSUER_URL=http://localhost:8080
ZITADEL_INTERNAL_URL=http://localhost:8080
ZITADEL_MASTERKEY=MasterkeySecret1234567890123456
ADMIN_PASSWORD=AdminSecure123!
NEXT_PUBLIC_ZITADEL_ISSUER=http://localhost:8080
NEXT_PUBLIC_ZITADEL_CLIENT_ID=dentalconnect-frontend

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
